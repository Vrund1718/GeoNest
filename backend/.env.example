PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/smart-pg-db
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173

# Optional Cloudinary (for production image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Twilio (for production SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_TOKEN_SECRET=change-me-in-production

# AI / LLM configuration (Optional: gemini or openai)
AI_PROVIDER=gemini
AI_API_KEY=

# OpenRouteService API key for commute duration calculations (Optional)
ORS_API_KEY=
