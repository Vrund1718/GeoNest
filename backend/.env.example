PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/smart-pg-db
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173

# Optional Cloudinary (for production image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Twilio (for production SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_TOKEN_SECRET=change-me-in-production

# AI / LLM configuration (Google Gemini API)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-2.0-flash-lite,gemini-1.5-pro

# OpenRouteService API key for commute duration calculations (Optional)
ORS_API_KEY=
